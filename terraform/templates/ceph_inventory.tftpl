# Auto-generated by Terraform for cephadm

[ceph]
%{ for i, node in ceph_nodes ~}
%{ if i < 3 ~}
${node.name} ansible_host=${node.mgmt_ip} labels="['_admin', 'mon', 'mgr', 'mds']"
%{ else ~}
${node.name} ansible_host=${node.mgmt_ip} labels="['rgw']"
%{ endif ~}
%{ endfor ~}

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/id_ed25519
ansible_become=true
