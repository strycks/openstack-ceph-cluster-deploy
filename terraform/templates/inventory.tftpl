# Auto-generated by Terraform

[openstack]
%{ for i, node in openstack_nodes ~}
${node.name} ansible_host=${node.mgmt_ip} internal_ip=${node.internal_ip} external_ip=${node.external_ip}
%{ endfor ~}

[ceph]
%{ for i, node in ceph_nodes ~}
%{ if i < 3 ~}
${node.name} ansible_host=${node.mgmt_ip} public_ip=${node.public_ip} cluster_ip=${node.cluster_ip} internal_ip=${node.internal_ip} labels="['_admin', 'mon', 'mgr', 'mds', 'osd']"
%{ else ~}
${node.name} ansible_host=${node.mgmt_ip} public_ip=${node.public_ip} cluster_ip=${node.cluster_ip} internal_ip=${node.internal_ip} labels="['rgw', 'osd']"
%{ endif ~}
%{ endfor ~}

[openstack_admin]
openstack-node1

[ceph_admin]
ceph-node1

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/id_ed25519
ansible_become=true
net_ceph_public=10.10.2.0/24
net_ceph_cluster=10.10.6.0/24
net_os_internal=10.10.3.10/24
net_os_external=10.10.4.10/24
net_os_tenant=10.10.5.10/24
