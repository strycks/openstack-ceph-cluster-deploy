# Auto-generated by Terraform

[ceph]
%{ for i, node in ceph_nodes ~}
%{ if i < 3 ~}
${node.name} ansible_host=${node.mgmt_ip} public_ip=${node.public_ip} cluster_ip=${node.cluster_ip} labels="['_admin', 'mon', 'mgr', 'osd']"
%{ else ~}
${node.name} ansible_host=${node.mgmt_ip} public_ip=${node.public_ip} cluster_ip=${node.cluster_ip} labels="['rgw', 'osd']"
%{ endif ~}
%{ endfor ~}

[ceph_admin]
ceph-node1

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/id_ed25519
ansible_become=true
net_ceph_public=10.10.2.0/24
net_ceph_cluster=10.10.6.0/24
