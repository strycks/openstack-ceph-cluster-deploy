# Auto-generated by Terraform

[openstack]
%{ for name, ip in openstack_nodes ~}
${name} ansible_host=${ip}
%{ endfor ~}

[ceph]
%{ for name, ip in ceph_nodes ~}
${name} ansible_host=${ip}
%{ endfor ~}

[all:vars]
ansible_user=ubuntu
ansible_ssh_private_key_file=~/.ssh/id_ed25519
ansible_become=true
